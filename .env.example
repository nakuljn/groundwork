OPENAI_API_KEY=sk-...
# Used for parsing activity logs, research and other background tasks
OPENAI_MODEL=gpt-4o-mini

# Model that writes outreach messages and plan steps.
# With ANTHROPIC_API_KEY set, Claude Sonnet is used by default; otherwise gpt-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional overrides: anthropic | openai | sarvam, and a model id for that provider
AI_WRITING_PROVIDER=
AI_WRITING_MODEL=

# Optional — lets Find people search the web for real prospects (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Optional — for Hindi/Hinglish message variants, or AI_WRITING_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m

# Supabase (production database). Set USE_LOCAL_SQLITE=true to force SQLite in dev.
USE_LOCAL_SQLITE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Use the Transaction pooler URI (port 6543) — direct db.*.supabase.co:5432 often fails on Render.
DATABASE_URL=postgresql://postgres.your-project:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=ap-south-1
# Optional server-only key for admin tasks
SUPABASE_SERVICE_ROLE_KEY=
